NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
GOOGLE_ANALYTICS_PROPERTY_ID=
GOOGLE_ANALYTICS_CLIENT_EMAIL=
GOOGLE_ANALYTICS_PRIVATE_KEY=
# Set to false when the public site is ready to launch.
SITE_LOCK_ENABLED=true
ADMIN_LOGIN_THROTTLE_SECRET=
CHECKOUT_THROTTLE_SECRET=
# Optional comma-separated list for preview/custom checkout return origins.
CHECKOUT_RETURN_ALLOWED_ORIGINS=
CONTACT_THROTTLE_SECRET=
# Runtime Cloudflare values. D1 uses the DB binding in wrangler.toml.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_R2_BUCKET_NAME=
CLOUDFLARE_R2_PUBLIC_BASE_URL=
# Required for admin product image upload/delete at runtime.
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_JURISDICTION=
# Do not add CLOUDFLARE_API_TOKEN here or to .env.worker.
# Keep deploy tokens in your local shell or CI secrets only.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
RESEND_API_KEY=
ORDER_NOTIFICATION_FROM=
# Optional. Defaults to orders@growncookies.co.uk when unset.
ORDER_NOTIFICATION_TO=
# Zoho Mail API credentials for contact-form delivery.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ACCOUNT_ID=
# Optional. Defaults to CONTACT_FORM_TO or orders@growncookies.co.uk when unset.
CONTACT_FORM_FROM=
# Optional. Defaults to orders@growncookies.co.uk when unset.
CONTACT_FORM_TO=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
