{
    "name": "grown-cookies",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev",
        "cloudflare:build": "opennextjs-cloudflare build",
        "cloudflare:preview": "npm run cloudflare:build && opennextjs-cloudflare preview",
        "cloudflare:deploy": "npm run cloudflare:build && opennextjs-cloudflare deploy -- --keep-vars",
        "cloudflare:deploy:domain": "npm run cloudflare:build && opennextjs-cloudflare deploy -- --keep-vars --domains growncookies.co.uk --domains www.growncookies.co.uk",
        "cloudflare:d1:migrate": "npx wrangler d1 migrations apply grown-cookies --remote",
        "auth:generate": "npx auth@1.7.7 generate --config auth.config.ts --output cloudflare/d1/generated-auth-schema.sql --yes",
        "auth:prepare-import": "node scripts/prepare-better-auth-import.mjs",
        "build": "next build --webpack",
        "start": "next start",
        "lint": "eslint",
        "dev:local": "next dev -H 0.0.0.0 -p 3000"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.1018.0",
        "@opennextjs/cloudflare": "^1.19.11",
        "@stripe/react-stripe-js": "^3.10.0",
        "@stripe/stripe-js": "^5.10.0",
        "bcryptjs": "^3.0.3",
        "better-auth": "^1.7.7",
        "better-auth-cloudflare": "^0.3.1",
        "canvas-confetti": "^1.9.4",
        "next": "^16.2.6",
        "react": "19.2.3",
        "react-dom": "19.2.3",
        "react-icons": "^5.5.0",
        "stripe": "^18.5.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@tailwindcss/postcss": "^4",
        "@types/better-sqlite3": "^7.6.13",
        "@types/canvas-confetti": "^1.9.0",
        "@types/node": "^20",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "better-sqlite3": "^12.4.1",
        "eslint": "^10.1.0",
        "eslint-config-next": "^0.2.4",
        "globals": "^17.4.0",
        "tailwindcss": "^4.2.2",
        "typescript": "^5",
        "typescript-eslint": "^8.57.2",
        "wrangler": "^4.96.0"
    }
}
