{
    "name": "grown-cookies",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev",
        "cloudflare:build": "next build && npx @cloudflare/next-on-pages",
        "cloudflare:deploy": "npm run cloudflare:build && npx wrangler pages deploy .vercel/output/static --project-name grown-cookies --commit-dirty=true",
        "cloudflare:d1:migrate": "npx wrangler d1 migrations apply grown-cookies --remote",
        "build": "next build",
        "start": "next start",
        "lint": "eslint",
        "dev:local": "next dev -H 0.0.0.0 -p 3000"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.1018.0",
        "@stripe/react-stripe-js": "^3.10.0",
        "@stripe/stripe-js": "^5.10.0",
        "@supabase/supabase-js": "^2.100.1",
        "next": "16.2.1",
        "react": "19.2.3",
        "react-dom": "19.2.3",
        "react-icons": "^5.5.0",
        "stripe": "^18.5.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@tailwindcss/postcss": "^4",
        "@types/node": "^20",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "eslint": "^10.1.0",
        "eslint-config-next": "^0.2.4",
        "globals": "^17.4.0",
        "tailwindcss": "^4.2.2",
        "typescript": "^5",
        "typescript-eslint": "^8.57.2",
        "wrangler": "^4.41.0"
    }
}
